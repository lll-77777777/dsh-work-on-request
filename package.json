{
  "name": "dsh-work-on-request",
  "version": "0.1.0",
  "description": "DSH 插件：提问就答，叫了才做 —— 只回答问题，明确让你干活时才动手",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "instruction",
    "guardrail"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check index.js && node --test test/"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
